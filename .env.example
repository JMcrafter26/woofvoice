CHAT_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama API server URL, use any other OpenAI-compatible API server URL if you have one
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gemma4:e4b                 # Example model
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5
AUDIO_DEVICE=                 # Optional sounddevice name or index, e.g. VB-CABLE
AUDIO_CHUNK_DIR=              # Optional directory for immediately-written spoken chunk WAV files
